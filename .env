# Variable de n8n
GENERIC_TIMEZONE=Africa/Douala
TZ=Africa/Douala
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_KEY
N8N_VERSION=VERSION_STABLE_A_CHOISIR
N8N_HOST=n8n.tondomaine.com
N8N_PROTOCOL=http # ou https pour le mode sécurisé
N8N_SECURE_COOKIE=false # false pour http true pour https (cookie sécurisé)
N8N_PROXY_HOPS=1
NODE_ENV=production
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
WEBHOOK_URL=https://n8n.tondomaine.com/
N8N_EDITOR_BASE_URL=https://n8n.tondomaine.com/
N8N_ENCRYPTION_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE



# Variable de la base de données
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
